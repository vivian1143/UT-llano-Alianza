    },
    {
      "type": "datetime",
      "id": "Field_fechaCierre",
      "key": "fechaCierre",
      "layout": {
        "row": "Row_5"
      },
      "subtype": "date",
      "dateLabel": "Fecha de cierre",
      "validate": {
        "required": true
      },
      "description": "Si pones la fecha de hoy, el temporizador cancela la aprobación"
    },
    {
      "label": "Simular adenda",
      "type": "checkbox",
      "id": "Field_simularAdenda",
      "key": "simularAdenda",
