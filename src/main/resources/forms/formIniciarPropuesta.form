      "key": "modalidadContratacion",
      "layout": {
        "row": "Row_2"
      },
      "values": [
        {
          "label": "Licitación pública",
          "value": "Licitación pública"
        },
        {
          "label": "Selección abreviada",
          "value": "Selección abreviada"
        },
        {
          "label": "Mínima cuantía",
          "value": "Mínima cuantía"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "label": "Entidad",
      "type": "textfield",
      "id": "Field_entidadContratante",
      "key": "entidadContratante",
      "layout": {
        "row": "Row_3"
      },
      "validate": {
        "required": true
      },
      "description": "Ej: Gobernación del Meta"
    },
    {
      "label": "Objeto del contrato",
      "type": "textarea",
      "id": "Field_objetoContrato",
      "key": "objetoContrato",
      "layout": {
        "row": "Row_4",
        "columns": null
      },
      "validate": {
        "required": true
      },
