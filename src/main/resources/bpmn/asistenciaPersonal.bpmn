<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0" id="Definitions_Asistencia" targetNamespace="http://ut-llano-alianza/bpmn" exporter="Manual" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Asistencia">
    <bpmn:participant id="Participant_main" name="UT Llano Alianza" processRef="procesoAsistenciaPersonal" />
    <bpmn:participant id="Participant_cli" name="Cliente (entidad compradora)" />
    <bpmn:participant id="Participant_per" name="Personal operativo" />
    <bpmn:messageFlow id="MessageFlow_1" name="Turnos programados" sourceRef="Activity_comCli" targetRef="Participant_cli" />
    <bpmn:messageFlow id="MessageFlow_2" name="Respuesta del cliente" sourceRef="Participant_cli" targetRef="Activity_resp" />
    <bpmn:messageFlow id="MessageFlow_3" name="Turnos asignados" sourceRef="Event_comPer" targetRef="Participant_per" />
    <bpmn:messageFlow id="MessageFlow_4" name="Aviso de ausencia" sourceRef="Participant_per" targetRef="Activity_verif" />
  </bpmn:collaboration>
  <bpmn:process id="procesoAsistenciaPersonal" name="Programar y Controlar Asistencia del Personal" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_Asistencia">
      <bpmn:lane id="Lane_0_Coordinador_Operativo" name="Coordinador Operativo">
        <bpmn:flowNodeRef>StartEvent_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_mA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_asignar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwPers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_comCli</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_resp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwCamb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_comPer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_mB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwInc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwMes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_split</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1_Gestion_Humana" name="Gestión Humana">
        <bpmn:flowNodeRef>Activity_gh</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2_Supervisor_de_sede" name="Supervisor de sede">
        <bpmn:flowNodeRef>Gateway_loop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_verif</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwNov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_dmnNov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwRee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_reem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_mrg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwSem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_recordar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_endRec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_bTimer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3_Analista_de_nomina" name="Analista de nómina">
        <bpmn:flowNodeRef>Activity_nom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4_Area_de_facturacion" name="Área de facturación">
        <bpmn:flowNodeRef>Activity_fac</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_start" name="Inicio de periodo mensual o acta de inicio">
      <bpmn:outgoing>Flow_1_start_plan</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_plan" name="Definir plan mensual de trabajo por sede" camunda:formRef="formPlanMensual" camunda:formRefBinding="latest" camunda:candidateGroups="coordinador">
      <bpmn:incoming>Flow_1_start_plan</bpmn:incoming>
      <bpmn:outgoing>Flow_2_plan_mA</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_mA" name="">
      <bpmn:incoming>Flow_2_plan_mA</bpmn:incoming>
      <bpmn:incoming>Flow_7_gh_mA</bpmn:incoming>
      <bpmn:incoming>Flow_11_gwCamb_mA</bpmn:incoming>
      <bpmn:outgoing>Flow_3_mA_asignar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_asignar" name="Asignar personal a turnos y sedes" camunda:formRef="formAsignarPersonal" camunda:formRefBinding="latest" camunda:candidateGroups="coordinador">
      <bpmn:incoming>Flow_3_mA_asignar</bpmn:incoming>
      <bpmn:outgoing>Flow_4_asignar_gwPers</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gwPers" name="¿Hay personal suficiente?">
      <bpmn:incoming>Flow_4_asignar_gwPers</bpmn:incoming>
      <bpmn:outgoing>Flow_5_gwPers_comCli</bpmn:outgoing>
      <bpmn:outgoing>Flow_6_gwPers_gh</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Activity_gh" name="Gestionar personal adicional" calledElement="procesoGestionarPersonalAdicional" camunda:calledElementBinding="latest">
      <bpmn:extensionElements><camunda:in variables="all" /><camunda:out variables="all" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_6_gwPers_gh</bpmn:incoming>
      <bpmn:outgoing>Flow_7_gh_mA</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sendTask id="Activity_comCli" name="Comunicar turnos al cliente" camunda:type="external" camunda:topic="comunicarTurnosCliente">
      <bpmn:incoming>Flow_5_gwPers_comCli</bpmn:incoming>
      <bpmn:outgoing>Flow_8_comCli_resp</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Activity_resp" name="Registrar respuesta del cliente" camunda:formRef="formRespuestaCliente" camunda:formRefBinding="latest" camunda:candidateGroups="coordinador">
      <bpmn:incoming>Flow_8_comCli_resp</bpmn:incoming>
      <bpmn:outgoing>Flow_9_resp_gwCamb</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gwCamb" name="¿Cliente pide cambios?">
      <bpmn:incoming>Flow_9_resp_gwCamb</bpmn:incoming>
      <bpmn:outgoing>Flow_10_gwCamb_comPer</bpmn:outgoing>
      <bpmn:outgoing>Flow_11_gwCamb_mA</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_comPer" name="Turnos comunicados al personal">
      <bpmn:incoming>Flow_10_gwCamb_comPer</bpmn:incoming>
      <bpmn:outgoing>Flow_12_comPer_loop</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_comPer" messageRef="Message_turnosAsignados" camunda:type="external" camunda:topic="comunicarTurnosPersonal" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_loop" name="">
      <bpmn:incoming>Flow_12_comPer_loop</bpmn:incoming>
      <bpmn:incoming>Flow_25_gwSem_loop</bpmn:incoming>
      <bpmn:incoming>Flow_31_gwMes_loop</bpmn:incoming>
      <bpmn:outgoing>Flow_13_loop_verif</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_verif" name="Verificar asistencia diaria en sede" camunda:formRef="formVerificarAsistencia" camunda:formRefBinding="latest" camunda:candidateGroups="supervisor">
      <bpmn:incoming>Flow_13_loop_verif</bpmn:incoming>
      <bpmn:outgoing>Flow_14_verif_gwNov</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gwNov" name="¿Hay ausencia o novedad?">
      <bpmn:incoming>Flow_14_verif_gwNov</bpmn:incoming>
      <bpmn:outgoing>Flow_15_gwNov_reg</bpmn:outgoing>
      <bpmn:outgoing>Flow_21_gwNov_mrg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_reg" name="Registrar novedad en APP o planilla" camunda:delegateExpression="${registrarNovedadDelegate}">
      <bpmn:incoming>Flow_15_gwNov_reg</bpmn:incoming>
      <bpmn:outgoing>Flow_16_reg_dmnNov</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_reg_dapp"><bpmn:targetRef>Data_dapp</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Activity_dmnNov" name="Evaluar novedad" camunda:resultVariable="accionNovedad" camunda:decisionRef="decisionEvaluarNovedad" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_16_reg_dmnNov</bpmn:incoming>
      <bpmn:outgoing>Flow_17_dmnNov_gwRee</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_gwRee" name="¿Requiere reemplazo?">
      <bpmn:incoming>Flow_17_dmnNov_gwRee</bpmn:incoming>
      <bpmn:outgoing>Flow_18_gwRee_reem</bpmn:outgoing>
      <bpmn:outgoing>Flow_19_gwRee_mrg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_reem" name="Cubrir ausencia con reemplazo" camunda:formRef="formCubrirAusencia" camunda:formRefBinding="latest" camunda:candidateGroups="supervisor">
      <bpmn:incoming>Flow_18_gwRee_reem</bpmn:incoming>
      <bpmn:outgoing>Flow_20_reem_mrg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_mrg" name="">
      <bpmn:incoming>Flow_19_gwRee_mrg</bpmn:incoming>
      <bpmn:incoming>Flow_20_reem_mrg</bpmn:incoming>
      <bpmn:incoming>Flow_21_gwNov_mrg</bpmn:incoming>
      <bpmn:outgoing>Flow_22_mrg_gwSem</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_gwSem" name="¿Terminó la semana?">
      <bpmn:incoming>Flow_22_mrg_gwSem</bpmn:incoming>
      <bpmn:outgoing>Flow_23_gwSem_mB</bpmn:outgoing>
      <bpmn:outgoing>Flow_25_gwSem_loop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_mB" name="">
      <bpmn:incoming>Flow_23_gwSem_mB</bpmn:incoming>
      <bpmn:incoming>Flow_28_corr_mB</bpmn:incoming>
      <bpmn:outgoing>Flow_24_mB_audit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_audit" name="Auditar novedades semanales" camunda:formRef="formAuditarNovedades" camunda:formRefBinding="latest" camunda:candidateGroups="coordinador">
      <bpmn:incoming>Flow_24_mB_audit</bpmn:incoming>
      <bpmn:outgoing>Flow_26_audit_gwInc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gwInc" name="¿Hay inconsistencias?">
      <bpmn:incoming>Flow_26_audit_gwInc</bpmn:incoming>
      <bpmn:outgoing>Flow_27_gwInc_corr</bpmn:outgoing>
      <bpmn:outgoing>Flow_29_gwInc_gwMes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_corr" name="Corregir novedades" camunda:formRef="formCorregirNovedades" camunda:formRefBinding="latest" camunda:candidateGroups="supervisor">
      <bpmn:incoming>Flow_27_gwInc_corr</bpmn:incoming>
      <bpmn:outgoing>Flow_28_corr_mB</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gwMes" name="¿Terminó el mes?">
      <bpmn:incoming>Flow_29_gwInc_gwMes</bpmn:incoming>
      <bpmn:outgoing>Flow_30_gwMes_cerrar</bpmn:outgoing>
      <bpmn:outgoing>Flow_31_gwMes_loop</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_cerrar" name="Cerrar prefactura mensual de novedades" camunda:delegateExpression="${cerrarPrefacturaDelegate}">
      <bpmn:incoming>Flow_30_gwMes_cerrar</bpmn:incoming>
      <bpmn:outgoing>Flow_32_cerrar_split</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_cerrar_dpre"><bpmn:targetRef>Data_dpre</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_split" name="">
      <bpmn:incoming>Flow_32_cerrar_split</bpmn:incoming>
      <bpmn:outgoing>Flow_33_split_nom</bpmn:outgoing>
      <bpmn:outgoing>Flow_34_split_fac</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Activity_nom" name="Recibir novedades para nómina" camunda:formRef="formRecibirNovedadesNomina" camunda:formRefBinding="latest" camunda:candidateGroups="nomina">
      <bpmn:incoming>Flow_33_split_nom</bpmn:incoming>
      <bpmn:outgoing>Flow_35_nom_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_fac" name="Recibir soportes para facturar" camunda:formRef="formRecibirSoportesFacturacion" camunda:formRefBinding="latest" camunda:candidateGroups="facturacion">
      <bpmn:incoming>Flow_34_split_fac</bpmn:incoming>
      <bpmn:outgoing>Flow_36_fac_join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_join" name="">
      <bpmn:incoming>Flow_35_nom_join</bpmn:incoming>
      <bpmn:incoming>Flow_36_fac_join</bpmn:incoming>
      <bpmn:outgoing>Flow_37_join_end</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_end" name="Novedades del mes cerradas">
      <bpmn:incoming>Flow_37_join_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_recordar" name="Recordar verificación al supervisor" camunda:type="external" camunda:topic="recordarVerificacionAsistencia">
      <bpmn:incoming>Flow_38_bTimer_recordar</bpmn:incoming>
      <bpmn:outgoing>Flow_39_recordar_endRec</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_endRec" name="Recordatorio enviado">
      <bpmn:incoming>Flow_39_recordar_endRec</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Event_bTimer" name="1 hora sin verificar" cancelActivity="false" attachedToRef="Activity_verif">
      <bpmn:outgoing>Flow_38_bTimer_recordar</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_bTimer"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1_start_plan" sourceRef="StartEvent_start" targetRef="Activity_plan" />
    <bpmn:sequenceFlow id="Flow_2_plan_mA" sourceRef="Activity_plan" targetRef="Gateway_mA" />
    <bpmn:sequenceFlow id="Flow_3_mA_asignar" sourceRef="Gateway_mA" targetRef="Activity_asignar" />
    <bpmn:sequenceFlow id="Flow_4_asignar_gwPers" sourceRef="Activity_asignar" targetRef="Gateway_gwPers" />
    <bpmn:sequenceFlow id="Flow_5_gwPers_comCli" name="Sí" sourceRef="Gateway_gwPers" targetRef="Activity_comCli">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${personalSuficiente}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6_gwPers_gh" name="No" sourceRef="Gateway_gwPers" targetRef="Activity_gh">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!personalSuficiente}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7_gh_mA" sourceRef="Activity_gh" targetRef="Gateway_mA" />
    <bpmn:sequenceFlow id="Flow_8_comCli_resp" sourceRef="Activity_comCli" targetRef="Activity_resp" />
    <bpmn:sequenceFlow id="Flow_9_resp_gwCamb" sourceRef="Activity_resp" targetRef="Gateway_gwCamb" />
    <bpmn:sequenceFlow id="Flow_10_gwCamb_comPer" name="No" sourceRef="Gateway_gwCamb" targetRef="Event_comPer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!clientePideCambios}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11_gwCamb_mA" name="Sí" sourceRef="Gateway_gwCamb" targetRef="Gateway_mA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${clientePideCambios}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12_comPer_loop" sourceRef="Event_comPer" targetRef="Gateway_loop" />
    <bpmn:sequenceFlow id="Flow_13_loop_verif" sourceRef="Gateway_loop" targetRef="Activity_verif" />
    <bpmn:sequenceFlow id="Flow_14_verif_gwNov" sourceRef="Activity_verif" targetRef="Gateway_gwNov" />
    <bpmn:sequenceFlow id="Flow_15_gwNov_reg" name="Sí" sourceRef="Gateway_gwNov" targetRef="Activity_reg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${huboNovedad}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16_reg_dmnNov" sourceRef="Activity_reg" targetRef="Activity_dmnNov" />
    <bpmn:sequenceFlow id="Flow_17_dmnNov_gwRee" sourceRef="Activity_dmnNov" targetRef="Gateway_gwRee" />
    <bpmn:sequenceFlow id="Flow_18_gwRee_reem" name="Sí" sourceRef="Gateway_gwRee" targetRef="Activity_reem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accionNovedad == 'reemplazar'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19_gwRee_mrg" name="No" sourceRef="Gateway_gwRee" targetRef="Gateway_mrg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accionNovedad == 'registrar'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20_reem_mrg" sourceRef="Activity_reem" targetRef="Gateway_mrg" />
    <bpmn:sequenceFlow id="Flow_21_gwNov_mrg" name="No" sourceRef="Gateway_gwNov" targetRef="Gateway_mrg">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!huboNovedad}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22_mrg_gwSem" sourceRef="Gateway_mrg" targetRef="Gateway_gwSem" />
    <bpmn:sequenceFlow id="Flow_23_gwSem_mB" name="Sí" sourceRef="Gateway_gwSem" targetRef="Gateway_mB">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${finSemana}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24_mB_audit" sourceRef="Gateway_mB" targetRef="Activity_audit" />
    <bpmn:sequenceFlow id="Flow_25_gwSem_loop" name="No" sourceRef="Gateway_gwSem" targetRef="Gateway_loop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!finSemana}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26_audit_gwInc" sourceRef="Activity_audit" targetRef="Gateway_gwInc" />
    <bpmn:sequenceFlow id="Flow_27_gwInc_corr" name="Sí" sourceRef="Gateway_gwInc" targetRef="Activity_corr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hayInconsistencias}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_28_corr_mB" sourceRef="Activity_corr" targetRef="Gateway_mB" />
    <bpmn:sequenceFlow id="Flow_29_gwInc_gwMes" name="No" sourceRef="Gateway_gwInc" targetRef="Gateway_gwMes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!hayInconsistencias}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_30_gwMes_cerrar" name="Sí" sourceRef="Gateway_gwMes" targetRef="Activity_cerrar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${finMes}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_31_gwMes_loop" name="No" sourceRef="Gateway_gwMes" targetRef="Gateway_loop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!finMes}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_32_cerrar_split" sourceRef="Activity_cerrar" targetRef="Gateway_split" />
    <bpmn:sequenceFlow id="Flow_33_split_nom" sourceRef="Gateway_split" targetRef="Activity_nom" />
    <bpmn:sequenceFlow id="Flow_34_split_fac" sourceRef="Gateway_split" targetRef="Activity_fac" />
    <bpmn:sequenceFlow id="Flow_35_nom_join" sourceRef="Activity_nom" targetRef="Gateway_join" />
    <bpmn:sequenceFlow id="Flow_36_fac_join" sourceRef="Activity_fac" targetRef="Gateway_join" />
    <bpmn:sequenceFlow id="Flow_37_join_end" sourceRef="Gateway_join" targetRef="EndEvent_end" />
    <bpmn:sequenceFlow id="Flow_38_bTimer_recordar" sourceRef="Event_bTimer" targetRef="Activity_recordar" />
