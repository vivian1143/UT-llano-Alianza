<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0" id="Definitions_Accidente" targetNamespace="http://ut-llano-alianza/bpmn" exporter="Manual" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Accidente">
    <bpmn:participant id="Participant_main" name="UT Llano Alianza" processRef="procesoAccidenteTrabajo" />
    <bpmn:participant id="Participant_min" name="Ministerio del Trabajo (Dirección Territorial)" />
    <bpmn:participant id="Participant_arl" name="ARL" />
    <bpmn:messageFlow id="MessageFlow_1" name="Reporte de accidente grave o mortal" sourceRef="Activity_repMin" targetRef="Participant_min" />
    <bpmn:messageFlow id="MessageFlow_2" name="FURAT" sourceRef="Activity_repARL" targetRef="Participant_arl" />
    <bpmn:messageFlow id="MessageFlow_3" name="Informe de investigación" sourceRef="Activity_remitir" targetRef="Participant_arl" />
    <bpmn:messageFlow id="MessageFlow_4" name="Concepto y recomendaciones" sourceRef="Participant_arl" targetRef="Event_concepto" />
  </bpmn:collaboration>
  <bpmn:process id="procesoAccidenteTrabajo" name="Investigar y Reportar Accidente de Trabajo" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_Accidente">
      <bpmn:lane id="Lane_0_Trabajador_afectado_o_testigo" name="Trabajador afectado o testigo">
        <bpmn:flowNodeRef>StartEvent_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_informar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1_Jefe_inmediato_Supervisor_de_sede" name="Jefe inmediato / Supervisor de sede">
        <bpmn:flowNodeRef>Activity_atender</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_mC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_implementar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2_Equipo_investigador" name="Equipo investigador">
        <bpmn:flowNodeRef>Activity_investigar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3_Analista_de_nomina" name="Analista de nómina">
        <bpmn:flowNodeRef>Activity_nomina</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4_Coordinador_SST" name="Coordinador SST">
        <bpmn:flowNodeRef>Activity_clasificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_dmnRep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwAcc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_furat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwGrave1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_repMin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_merge1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_repARL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwInc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_merge2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_merge3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_conformar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwGrave2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_remitir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_evgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_concepto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_sinResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_revConcepto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_mergeA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_merge4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_definir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gwEfic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_matriz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_start" name="Accidente o incidente ocurrido">
      <bpmn:outgoing>Flow_1_start_informar</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_informar" name="Informar evento al jefe inmediato" camunda:formRef="formInformarEvento" camunda:formRefBinding="latest" camunda:candidateGroups="trabajador">
      <bpmn:incoming>Flow_1_start_informar</bpmn:incoming>
      <bpmn:outgoing>Flow_2_informar_atender</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_atender" name="Atender al trabajador y asegurar el área" camunda:formRef="formAtenderTrabajador" camunda:formRefBinding="latest" camunda:candidateGroups="supervisor">
      <bpmn:incoming>Flow_2_informar_atender</bpmn:incoming>
      <bpmn:outgoing>Flow_3_atender_notificar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_notificar" name="Notificar evento al área SST" camunda:type="external" camunda:topic="notificarSst">
      <bpmn:incoming>Flow_3_atender_notificar</bpmn:incoming>
      <bpmn:outgoing>Flow_4_notificar_clasificar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_clasificar" name="Registrar y clasificar evento" camunda:formRef="formClasificarEvento" camunda:formRefBinding="latest" camunda:candidateGroups="sst">
      <bpmn:incoming>Flow_4_notificar_clasificar</bpmn:incoming>
      <bpmn:outgoing>Flow_5_clasificar_dmnRep</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Activity_dmnRep" name="Determinar reportes requeridos" camunda:resultVariable="nivelReporte" camunda:decisionRef="decisionReportesAccidente" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_5_clasificar_dmnRep</bpmn:incoming>
      <bpmn:outgoing>Flow_6_dmnRep_gwAcc</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_gwAcc" name="¿Es accidente de trabajo?">
      <bpmn:incoming>Flow_6_dmnRep_gwAcc</bpmn:incoming>
      <bpmn:outgoing>Flow_7_gwAcc_furat</bpmn:outgoing>
      <bpmn:outgoing>Flow_18_gwAcc_merge3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_furat" name="Diligenciar FURAT" camunda:formRef="formDiligenciarFurat" camunda:formRefBinding="latest" camunda:candidateGroups="sst">
      <bpmn:incoming>Flow_7_gwAcc_furat</bpmn:incoming>
      <bpmn:outgoing>Flow_8_furat_gwGrave1</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_furat_dfurat"><bpmn:targetRef>Data_dfurat</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gwGrave1" name="¿Es grave o mortal?">
      <bpmn:incoming>Flow_8_furat_gwGrave1</bpmn:incoming>
      <bpmn:outgoing>Flow_9_gwGrave1_repMin</bpmn:outgoing>
      <bpmn:outgoing>Flow_10_gwGrave1_merge1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_repMin" name="Reportar a Dirección Territorial" camunda:type="external" camunda:topic="reportarMintrabajo">
      <bpmn:incoming>Flow_9_gwGrave1_repMin</bpmn:incoming>
      <bpmn:outgoing>Flow_11_repMin_merge1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_merge1" name="">
      <bpmn:incoming>Flow_10_gwGrave1_merge1</bpmn:incoming>
      <bpmn:incoming>Flow_11_repMin_merge1</bpmn:incoming>
      <bpmn:outgoing>Flow_12_merge1_repARL</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_repARL" name="Reportar accidente a ARL y EPS" camunda:type="external" camunda:topic="reportarArlEps">
      <bpmn:incoming>Flow_12_merge1_repARL</bpmn:incoming>
      <bpmn:outgoing>Flow_13_repARL_gwInc</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_gwInc" name="¿Generó incapacidad?">
      <bpmn:incoming>Flow_13_repARL_gwInc</bpmn:incoming>
      <bpmn:outgoing>Flow_14_gwInc_nomina</bpmn:outgoing>
      <bpmn:outgoing>Flow_15_gwInc_merge2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_nomina" name="Registrar incapacidad como novedad" camunda:formRef="formRegistrarIncapacidad" camunda:formRefBinding="latest" camunda:candidateGroups="nomina">
      <bpmn:incoming>Flow_14_gwInc_nomina</bpmn:incoming>
      <bpmn:outgoing>Flow_16_nomina_merge2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_merge2" name="">
      <bpmn:incoming>Flow_15_gwInc_merge2</bpmn:incoming>
      <bpmn:incoming>Flow_16_nomina_merge2</bpmn:incoming>
      <bpmn:outgoing>Flow_17_merge2_merge3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_merge3" name="">
      <bpmn:incoming>Flow_17_merge2_merge3</bpmn:incoming>
      <bpmn:incoming>Flow_18_gwAcc_merge3</bpmn:incoming>
      <bpmn:outgoing>Flow_19_merge3_conformar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_conformar" name="Conformar equipo investigador" camunda:formRef="formConformarEquipo" camunda:formRefBinding="latest" camunda:candidateGroups="sst">
      <bpmn:incoming>Flow_19_merge3_conformar</bpmn:incoming>
      <bpmn:outgoing>Flow_20_conformar_investigar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="Activity_investigar" name="Investigar accidente" calledElement="procesoInvestigarAccidente" camunda:calledElementBinding="latest">
      <bpmn:extensionElements><camunda:in variables="all" /><camunda:out variables="all" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_20_conformar_investigar</bpmn:incoming>
      <bpmn:outgoing>Flow_21_investigar_gwGrave2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_gwGrave2" name="¿Es grave o mortal?">
      <bpmn:incoming>Flow_21_investigar_gwGrave2</bpmn:incoming>
      <bpmn:outgoing>Flow_22_gwGrave2_remitir</bpmn:outgoing>
      <bpmn:outgoing>Flow_23_gwGrave2_merge4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_remitir" name="Remitir investigación a ARL" camunda:type="external" camunda:topic="remitirInvestigacionArl">
      <bpmn:incoming>Flow_22_gwGrave2_remitir</bpmn:incoming>
      <bpmn:outgoing>Flow_24_remitir_evgw</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_evgw" name="">
      <bpmn:incoming>Flow_24_remitir_evgw</bpmn:incoming>
      <bpmn:outgoing>Flow_25_evgw_sinResp</bpmn:outgoing>
      <bpmn:outgoing>Flow_26_evgw_concepto</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_concepto" name="Concepto de ARL recibido">
      <bpmn:incoming>Flow_26_evgw_concepto</bpmn:incoming>
      <bpmn:outgoing>Flow_27_concepto_revConcepto</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_concepto" messageRef="Message_conceptoArl" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_sinResp" name="15 días sin respuesta">
      <bpmn:incoming>Flow_25_evgw_sinResp</bpmn:incoming>
      <bpmn:outgoing>Flow_29_sinResp_mergeA</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_sinResp"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Activity_revConcepto" name="Revisar concepto de ARL" camunda:formRef="formRevisarConceptoArl" camunda:formRefBinding="latest" camunda:candidateGroups="sst">
      <bpmn:incoming>Flow_27_concepto_revConcepto</bpmn:incoming>
      <bpmn:outgoing>Flow_28_revConcepto_mergeA</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_mergeA" name="">
      <bpmn:incoming>Flow_28_revConcepto_mergeA</bpmn:incoming>
      <bpmn:incoming>Flow_29_sinResp_mergeA</bpmn:incoming>
      <bpmn:outgoing>Flow_30_mergeA_merge4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_merge4" name="">
      <bpmn:incoming>Flow_23_gwGrave2_merge4</bpmn:incoming>
      <bpmn:incoming>Flow_30_mergeA_merge4</bpmn:incoming>
      <bpmn:outgoing>Flow_31_merge4_definir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_definir" name="Definir acciones y registrarlas en SIG" camunda:formRef="formDefinirAcciones" camunda:formRefBinding="latest" camunda:candidateGroups="sst">
      <bpmn:incoming>Flow_31_merge4_definir</bpmn:incoming>
      <bpmn:outgoing>Flow_32_definir_mC</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_definir_dsig"><bpmn:targetRef>Data_dsig</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_mC" name="">
      <bpmn:incoming>Flow_32_definir_mC</bpmn:incoming>
      <bpmn:incoming>Flow_37_gwEfic_mC</bpmn:incoming>
      <bpmn:outgoing>Flow_33_mC_implementar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_implementar" name="Implementar acciones correctivas" camunda:formRef="formImplementarAcciones" camunda:formRefBinding="latest" camunda:candidateGroups="supervisor">
      <bpmn:incoming>Flow_33_mC_implementar</bpmn:incoming>
      <bpmn:outgoing>Flow_34_implementar_verificar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_verificar" name="Verificar cierre de acciones" camunda:formRef="formVerificarAcciones" camunda:formRefBinding="latest" camunda:candidateGroups="sst">
      <bpmn:incoming>Flow_34_implementar_verificar</bpmn:incoming>
      <bpmn:outgoing>Flow_35_verificar_gwEfic</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gwEfic" name="¿Acciones cerradas y eficaces?">
      <bpmn:incoming>Flow_35_verificar_gwEfic</bpmn:incoming>
      <bpmn:outgoing>Flow_36_gwEfic_matriz</bpmn:outgoing>
      <bpmn:outgoing>Flow_37_gwEfic_mC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_matriz" name="Actualizar matriz de riesgos e inspecciones" camunda:type="external" camunda:topic="actualizarMatrizRiesgos">
      <bpmn:incoming>Flow_36_gwEfic_matriz</bpmn:incoming>
      <bpmn:outgoing>Flow_38_matriz_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_end" name="Caso investigado y cerrado">
      <bpmn:incoming>Flow_38_matriz_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1_start_informar" sourceRef="StartEvent_start" targetRef="Activity_informar" />
    <bpmn:sequenceFlow id="Flow_2_informar_atender" sourceRef="Activity_informar" targetRef="Activity_atender" />
    <bpmn:sequenceFlow id="Flow_3_atender_notificar" sourceRef="Activity_atender" targetRef="Activity_notificar" />
    <bpmn:sequenceFlow id="Flow_4_notificar_clasificar" sourceRef="Activity_notificar" targetRef="Activity_clasificar" />
    <bpmn:sequenceFlow id="Flow_5_clasificar_dmnRep" sourceRef="Activity_clasificar" targetRef="Activity_dmnRep" />
    <bpmn:sequenceFlow id="Flow_6_dmnRep_gwAcc" sourceRef="Activity_dmnRep" targetRef="Gateway_gwAcc" />
    <bpmn:sequenceFlow id="Flow_7_gwAcc_furat" name="Sí" sourceRef="Gateway_gwAcc" targetRef="Activity_furat">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nivelReporte != 'ninguno'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_8_furat_gwGrave1" sourceRef="Activity_furat" targetRef="Gateway_gwGrave1" />
    <bpmn:sequenceFlow id="Flow_9_gwGrave1_repMin" name="Sí" sourceRef="Gateway_gwGrave1" targetRef="Activity_repMin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nivelReporte == 'arlMinisterio'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10_gwGrave1_merge1" name="No" sourceRef="Gateway_gwGrave1" targetRef="Gateway_merge1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nivelReporte != 'arlMinisterio'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11_repMin_merge1" sourceRef="Activity_repMin" targetRef="Gateway_merge1" />
    <bpmn:sequenceFlow id="Flow_12_merge1_repARL" sourceRef="Gateway_merge1" targetRef="Activity_repARL" />
    <bpmn:sequenceFlow id="Flow_13_repARL_gwInc" sourceRef="Activity_repARL" targetRef="Gateway_gwInc" />
    <bpmn:sequenceFlow id="Flow_14_gwInc_nomina" name="Sí" sourceRef="Gateway_gwInc" targetRef="Activity_nomina">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${generoIncapacidad}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15_gwInc_merge2" name="No" sourceRef="Gateway_gwInc" targetRef="Gateway_merge2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!generoIncapacidad}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16_nomina_merge2" sourceRef="Activity_nomina" targetRef="Gateway_merge2" />
    <bpmn:sequenceFlow id="Flow_17_merge2_merge3" sourceRef="Gateway_merge2" targetRef="Gateway_merge3" />
    <bpmn:sequenceFlow id="Flow_18_gwAcc_merge3" name="No" sourceRef="Gateway_gwAcc" targetRef="Gateway_merge3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nivelReporte == 'ninguno'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19_merge3_conformar" sourceRef="Gateway_merge3" targetRef="Activity_conformar" />
    <bpmn:sequenceFlow id="Flow_20_conformar_investigar" sourceRef="Activity_conformar" targetRef="Activity_investigar" />
    <bpmn:sequenceFlow id="Flow_21_investigar_gwGrave2" sourceRef="Activity_investigar" targetRef="Gateway_gwGrave2" />
    <bpmn:sequenceFlow id="Flow_22_gwGrave2_remitir" name="Sí" sourceRef="Gateway_gwGrave2" targetRef="Activity_remitir">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nivelReporte == 'arlMinisterio'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23_gwGrave2_merge4" name="No" sourceRef="Gateway_gwGrave2" targetRef="Gateway_merge4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nivelReporte != 'arlMinisterio'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24_remitir_evgw" sourceRef="Activity_remitir" targetRef="Gateway_evgw" />
    <bpmn:sequenceFlow id="Flow_25_evgw_sinResp" sourceRef="Gateway_evgw" targetRef="Event_sinResp" />
    <bpmn:sequenceFlow id="Flow_26_evgw_concepto" sourceRef="Gateway_evgw" targetRef="Event_concepto" />
    <bpmn:sequenceFlow id="Flow_27_concepto_revConcepto" sourceRef="Event_concepto" targetRef="Activity_revConcepto" />
    <bpmn:sequenceFlow id="Flow_28_revConcepto_mergeA" sourceRef="Activity_revConcepto" targetRef="Gateway_mergeA" />
    <bpmn:sequenceFlow id="Flow_29_sinResp_mergeA" sourceRef="Event_sinResp" targetRef="Gateway_mergeA" />
    <bpmn:sequenceFlow id="Flow_30_mergeA_merge4" sourceRef="Gateway_mergeA" targetRef="Gateway_merge4" />
    <bpmn:sequenceFlow id="Flow_31_merge4_definir" sourceRef="Gateway_merge4" targetRef="Activity_definir" />
    <bpmn:sequenceFlow id="Flow_32_definir_mC" sourceRef="Activity_definir" targetRef="Gateway_mC" />
    <bpmn:sequenceFlow id="Flow_33_mC_implementar" sourceRef="Gateway_mC" targetRef="Activity_implementar" />
    <bpmn:sequenceFlow id="Flow_34_implementar_verificar" sourceRef="Activity_implementar" targetRef="Activity_verificar" />
    <bpmn:sequenceFlow id="Flow_35_verificar_gwEfic" sourceRef="Activity_verificar" targetRef="Gateway_gwEfic" />
    <bpmn:sequenceFlow id="Flow_36_gwEfic_matriz" name="Sí" sourceRef="Gateway_gwEfic" targetRef="Activity_matriz">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${accionesEficaces}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_37_gwEfic_mC" name="No" sourceRef="Gateway_gwEfic" targetRef="Gateway_mC">
